# NotebookLM Podcast Automator - 环境变量配置
# =============================================

# ========== NotebookLM 认证 ==========
# 从 ~/.nlm/env 迁移或使用 nlm auth 获取
NLM_AUTH_TOKEN=你的AUTH_TOKEN
NLM_COOKIES=你的COOKIES

# ========== 代理配置 (国内环境需要) ==========
# 如果在国外服务器运行，可以注释掉
# HTTP_PROXY=http://127.0.0.1:10809
# HTTPS_PROXY=http://127.0.0.1:10809

# ========== Cloudflare R2 配置 ==========
# 从 Cloudflare Dashboard -> R2 管理页面获取

# R2 Account ID (在 R2 概览页右侧可以看到)
R2_ACCOUNT_ID=你的账户ID

# R2 Access Key (R2 -> 管理 R2 API 令牌 -> 创建 API 令牌)
R2_ACCESS_KEY_ID=你的AccessKeyId
R2_SECRET_ACCESS_KEY=你的SecretAccessKey

# R2 存储桶名称
R2_BUCKET_NAME=podcast

# R2 公开访问的 URL 前缀 (您的自定义域名，不带结尾斜杠)
R2_PUBLIC_URL=https://podcast.izm.de

# ========== 播客 RSS 配置 ==========
# 这些信息会显示在 Apple Podcast / 小宇宙 / 喜马拉雅 等应用中

# 播客标题
PODCAST_TITLE=WeChat Daily Podcast

# 播客简介
PODCAST_DESCRIPTION=自动生成的微信公众号文章播客摘要

# 作者名称
PODCAST_AUTHOR=AI Assistant

# 所有者名称 (用于验证)
PODCAST_OWNER_NAME=Your Name

# 所有者邮箱 (⚠️ 必须真实有效，喜马拉雅等平台会用于验证)
PODCAST_OWNER_EMAIL=your-email@example.com
