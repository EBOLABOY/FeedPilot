# NotebookLM Podcast Automator - 环境变量配置
# =============================================

# ========== NotebookLM 认证 ==========
# 从 ~/.nlm/env 迁移或使用 nlm auth 获取
NLM_AUTH_TOKEN=你的AUTH_TOKEN
NLM_COOKIES=你的COOKIES
# 可选：会话参数（程序会在刷新时自动同步，一般不需要手动填写）
# NLM_F_SID=1234567890123456789
# NLM_BL=boq_labs-tailwind-frontend_20260120.01_p0
# 可选：关闭自动会话同步（默认 false，不建议关闭）
# NLM_DISABLE_WEB_SESSION_REFRESH=false
# 可选：刷新失败后触发浏览器交互重登（Docker 场景建议 true）
# NLM_BROWSER_AUTH_ON_REFRESH_FAIL=true
# 可选：交互重登时保留浏览器窗口秒数（>0 时启用人工登录窗口）
# NLM_BROWSER_KEEP_OPEN_SECONDS=600
# 可选：浏览器是否强制无头（交互登录时建议 false）
# NLM_BROWSER_HEADLESS=false
# 可选：容器内启用 VNC 浏览器桌面（配合 docker-compose 5900 端口）
# NLM_ENABLE_VNC_BROWSER=true
# NLM_VNC_PORT=5900

# 可选：只发送指定 Cookies 子集（逗号/空格分隔；支持前缀*通配）。
# 用途：测试哪些 Cookies 是必须的。
# NLM_COOKIE_ALLOWLIST=SID,__Secure-*,HSID,SSID,OSID,__Secure-OSID,SAPISID,APISID,NID,AEC,SIDCC,__Secure-1PSIDCC,__Secure-3PSIDCC

# ========== HTTP 服务入口 ==========
# 服务监听地址（优先级：NPA_HTTP_ADDR > PORT > NPA_PORT）
# NPA_HTTP_ADDR=:8080
# PORT=8080
NPA_INPUT_URL=http://192.168.100.3:10082/atom

# 每次运行最多处理多少篇“新文章”（会自动跳过已处理/已跳过的旧文章）
# NPA_MAX_ENTRIES=50

# 本地状态库（用于去重与记录已处理/已跳过）
# NPA_STATE_PATH=data/state.json
# 状态库最多保留条目数（上限 100；超过会按最近处理时间裁剪）
# NPA_STATE_MAX_ENTRIES=100
# NPA_STATE_DISABLED=false

# ========== 内置定时任务（可选） ==========
# 设置后，服务会在每天固定时间自动触发一次工作流（仍可手动 POST /run）
# NPA_SCHEDULE_AT=06:00
# NPA_SCHEDULE_TZ=Asia/Shanghai

# ========== 代理配置 (国内环境需要) ==========
# 如果在国外服务器运行，可以注释掉
# NLM_PROXY_URL=http://127.0.0.1:10809
# HTTP_PROXY=http://127.0.0.1:10809
# HTTPS_PROXY=http://127.0.0.1:10809

# ========== Cloudflare R2 配置 ==========
# 从 Cloudflare Dashboard -> R2 管理页面获取

# R2 Account ID (在 R2 概览页右侧可以看到)
R2_ACCOUNT_ID=你的账户ID

# R2 Access Key (R2 -> 管理 R2 API 令牌 -> 创建 API 令牌)
R2_ACCESS_KEY_ID=你的AccessKeyId
R2_SECRET_ACCESS_KEY=你的SecretAccessKey

# R2 存储桶名称
R2_BUCKET_NAME=podcast

# R2 公开访问的 URL 前缀 (您的自定义域名，不带结尾斜杠)
R2_PUBLIC_URL=https://mypodcast.de5.net

# ========== 播客 RSS 配置 ==========
# 这些信息会显示在 Apple Podcast / 小宇宙 / 喜马拉雅 等应用中

# 播客标题
PODCAST_TITLE=WeChat Daily Podcast

# 播客简介
PODCAST_DESCRIPTION=自动生成的微信公众号文章播客摘要

# 作者名称
PODCAST_AUTHOR=AI Assistant

# 所有者名称 (用于验证)
PODCAST_OWNER_NAME=Your Name

# 所有者邮箱 (⚠️ 必须真实有效，喜马拉雅等平台会用于验证)
PODCAST_OWNER_EMAIL=your-email@example.com

# 封面图片 URL（可选；默认: <R2_PUBLIC_URL>/cover.jpg）
# 注意：Apple Podcasts 要求封面为 JPG/PNG、3000x3000、RGB，并支持 HTTP HEAD 与 Range。
# PODCAST_COVER_URL=https://mypodcast.de5.net/cover.jpg

# iTunes 相关字段（用于 Apple Podcasts Connect）
# iTunes Summary（可选；默认使用 PODCAST_DESCRIPTION）
# PODCAST_ITUNES_SUMMARY=自动生成的微信公众号文章播客摘要

# iTunes Explicit（必填；默认 no；可选值：yes | no | clean）
# PODCAST_ITUNES_EXPLICIT=no

# iTunes Type（可选；默认 episodic；可选值：episodic | serial）
# PODCAST_ITUNES_TYPE=episodic

# iTunes Category（必填；默认 Education；请使用 Apple 认可的分类名，注意大小写）
# PODCAST_ITUNES_CATEGORY=Education

# RSS 中最多保留多少期节目（可选；不设置/<=0 表示不裁剪）
# 例如：测试期只想保留最新 1 期：PODCAST_MAX_ITEMS=1
# PODCAST_MAX_ITEMS=0

# ========== 内容过滤（可选） ==========
# 过滤模式：none | rules | llm | hybrid
# - rules: 关键词/长度规则过滤
# - llm:   走 LLM 语义过滤（需要配置下方 LLM 变量）
# - hybrid: 先规则后 LLM
# NPA_FILTER_MODE=rules

# 规则过滤：命中关键词则过滤（逗号分隔），不填则使用内置默认列表
# NPA_FILTER_BLOCK_KEYWORDS=报名,考试,招聘,公示

# 规则过滤：允许关键词（命中则优先保留）
# NPA_FILTER_ALLOW_KEYWORDS=深度,解读,调查,评论

# 规则过滤：正文最小字符数（低于则过滤）
# NPA_FILTER_MIN_CONTENT_CHARS=800

# 严格模式：过滤后为空则直接失败（默认 false；否则返回 noop，不生成播客）
# NPA_FILTER_STRICT=true

# ========== LLM 过滤（OpenAI 兼容，可选） ==========
# OpenAI/DeepSeek/Qwen 等大多数提供 OpenAI 兼容接口的服务都可用
# NPA_FILTER_LLM_BASE_URL=https://api.openai.com/v1
# NPA_FILTER_LLM_MODEL=gpt-4o-mini
# NPA_FILTER_LLM_API_KEY=你的API_KEY
# NPA_FILTER_LLM_MAX_CHARS=0
# NPA_FILTER_LLM_TIMEOUT_SECONDS=300
# 网络波动自动重试次数（默认 2；0 表示不重试）
# NPA_FILTER_LLM_RETRIES=2

# ========== NotebookLM Cookie Keepalive (optional) ==========
# Refresh SNlM0e + merge Set-Cookie on an interval (useful for short-lived cookies like __Secure-1PSIDTS).
# NLM_KEEPALIVE_INTERVAL=12h
# Persist refreshed token/cookies back to .env and ~/.nlm/env (cookies require NLM_PERSIST_COOKIES=true).
# NLM_KEEPALIVE_PERSIST=true
# Persist NLM_COOKIES when refresh succeeds.
# NLM_PERSIST_COOKIES=true
